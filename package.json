{
  "name": "tailhome-monorepo",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "web:dev": "pnpm --filter @tailhome/web dev",
    "web:build": "pnpm --filter @tailhome/web build",
    "web:lint": "pnpm --filter @tailhome/web lint",
    "web:test": "pnpm --filter @tailhome/web test",
    "web:typecheck": "pnpm --filter @tailhome/web exec tsc --noEmit",
    "dashboard:dev": "pnpm --filter @tailhome/dashboard dev",
    "dashboard:build": "pnpm --filter @tailhome/dashboard build",
    "installer:build": "scripts/build-installer-bundle.sh"
  }
}
